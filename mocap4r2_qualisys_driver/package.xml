<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mocap4r2_qualisys_driver</name>
  <version>2.0.0</version>
  <description>MOCAP4ROS2 driver for Qualisys systems (Qualisys Track Manager), built on the Qualisys C++ SDK (RT protocol 1.28)</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <license>Apache-2.0</license>
  <license file="ThirdParty/qualisys_cpp_sdk/LICENSE.md">MIT</license>
  <license file="ThirdParty/qualisys_cpp_sdk/External/tinyxml2/LICENSE.txt">Zlib</license>
  <url type="website">https://mocap4ros2-project.github.io</url>
  <url type="repository">https://github.com/MOCAP4ROS2-Project/mocap4ros2_qualisys</url>
  <url type="bugtracker">https://github.com/MOCAP4ROS2-Project/mocap4ros2_qualisys/issues</url>
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mocap4r2_control</depend>
  <depend>mocap4r2_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>mocap4r2_marker_viz</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
